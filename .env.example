# Copy to .env and fill in. .env is gitignored.

# Where the original run directory's outputs/ lives. Only regeneration needs it.
AMLC_ARCHIVE=/path/to/run/outputs

# Hugging Face, for fetching the released dataset and the baseline weights.
HF_TOKEN=

# Kaggle, for downloading AMLworld.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Judge APIs for the four-step audit rubric. Only scripts/19a_run_judges.py
# uses these.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Conda installation root and the environment name the slurm jobs activate.
CONDA_ROOT=/opt/conda
AMLC_ENV=amlc-bench

# Cluster nodes for the slurm scripts.
VLLM_NODE_4GPU=
VLLM_NODE_8GPU=
