* text=auto eol=lf

*.npy   binary
*.npz   binary
*.pt    binary
*.pdf   binary
*.png   binary
*.parquet binary

# Vendored prompt templates are the executed prompts; keep them byte-exact.
prompts/** -text

# Preserve generated evidence bytes used in provenance hashes.
results/analysis/heldout_sampling/*.csv -text whitespace=cr-at-eol
results/analysis/target_integrity/*.csv -text whitespace=cr-at-eol
